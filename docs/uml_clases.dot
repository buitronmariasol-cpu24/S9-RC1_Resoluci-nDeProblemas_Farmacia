digraph G {
  rankdir=LR; compound=true; splines=true; nodesep=0.35; ranksep=0.6; fontname="DejaVu Sans";
  node [shape=plain, fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", fontsize=10, arrowsize=0.9];
  subgraph cluster_modelo { label="«package» modelo"; labeljust=l; style="rounded,dashed"; color="#555555"; fontsize=14; margin=14;
    Producto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="13">«abstract»<BR/><I><B>Producto</B></I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">- codigo : String<BR ALIGN="LEFT"/>- nombre : String<BR ALIGN="LEFT"/>- cantidad : int<BR ALIGN="LEFT"/>- costoUnitario : double<BR ALIGN="LEFT"/></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">+ Producto(codigo, nombre, cantidad, costoUnitario)<BR ALIGN="LEFT"/><I>+ getTipo() : String</I><BR ALIGN="LEFT"/><I>+ getPrecioVenta(hoy : LocalDate) : double</I><BR ALIGN="LEFT"/><I>+ estaVencido(hoy : LocalDate) : boolean</I><BR ALIGN="LEFT"/><I>+ estaPorVencer(hoy : LocalDate) : boolean</I><BR ALIGN="LEFT"/><I>+ getVigencia() : String</I><BR ALIGN="LEFT"/>+ aumentarStock(unidades : int) : void<BR ALIGN="LEFT"/>+ disminuirStock(unidades : int) : void<BR ALIGN="LEFT"/>+ getCostoTotal() : double<BR ALIGN="LEFT"/>+ getCodigo() / getNombre() / getCantidad()<BR ALIGN="LEFT"/>+ getCostoUnitario() : double<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    ProductoPerecedero [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="13"><B>ProductoPerecedero</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">- fechaVencimiento : LocalDate<BR ALIGN="LEFT"/></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">+ ProductoPerecedero(codigo, nombre, cantidad, costoUnitario, fechaVencimiento)<BR ALIGN="LEFT"/>+ getFechaVencimiento() : LocalDate<BR ALIGN="LEFT"/>+ getTipo() : String<BR ALIGN="LEFT"/>+ getPrecioVenta(hoy : LocalDate) : double<BR ALIGN="LEFT"/>+ estaVencido(hoy : LocalDate) : boolean<BR ALIGN="LEFT"/>+ estaPorVencer(hoy : LocalDate) : boolean<BR ALIGN="LEFT"/>+ getVigencia() : String<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    ProductoNoPerecedero [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="13"><B>ProductoNoPerecedero</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">+ ProductoNoPerecedero(codigo, nombre, cantidad, costoUnitario)<BR ALIGN="LEFT"/>+ getTipo() : String<BR ALIGN="LEFT"/>+ getPrecioVenta(hoy : LocalDate) : double<BR ALIGN="LEFT"/>+ estaVencido(hoy : LocalDate) : boolean<BR ALIGN="LEFT"/>+ estaPorVencer(hoy : LocalDate) : boolean<BR ALIGN="LEFT"/>+ getVigencia() : String<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_negocio { label="«package» negocio"; labeljust=l; style="rounded,dashed"; color="#555555"; fontsize=14; margin=14;
    Inventario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="13"><B>Inventario</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12"><U>+ CAPACIDAD_MAXIMA : int = 1000</U><BR ALIGN="LEFT"/><U>+ PRESUPUESTO_MENSUAL : double = 1000.00</U><BR ALIGN="LEFT"/><U>+ STOCK_BAJO : int = 10</U><BR ALIGN="LEFT"/>- productos : ArrayList&lt;Producto&gt;<BR ALIGN="LEFT"/>- hoy : LocalDate<BR ALIGN="LEFT"/>- presupuestoDisponible : double<BR ALIGN="LEFT"/>- ingresosPorVentas : double<BR ALIGN="LEFT"/>- perdidasPorVencimiento : double<BR ALIGN="LEFT"/></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">+ Inventario(hoy : LocalDate)<BR ALIGN="LEFT"/>+ registrarProducto(tipo, codigo, nombre, cantidadTxt, costoTxt, vencimientoTxt : String) : String  «RF1»<BR ALIGN="LEFT"/>+ getProductos() : ArrayList&lt;Producto&gt;  «RF2»<BR ALIGN="LEFT"/>+ buscarPorCodigo(codigo : String) : Producto  «RF2»<BR ALIGN="LEFT"/>+ vender(codigo, cantidadTxt : String) : String  «RF3»<BR ALIGN="LEFT"/>+ reabastecer(codigo, cantidadTxt : String) : String  «RF4»<BR ALIGN="LEFT"/>+ retirarVencidos() : int  «RF6»<BR ALIGN="LEFT"/>+ totalUnidades() : int<BR ALIGN="LEFT"/>+ valorInventario() : double  «RF7»<BR ALIGN="LEFT"/>+ agregarInicial(p : Producto) : void<BR ALIGN="LEFT"/>+ getHoy() : LocalDate<BR ALIGN="LEFT"/>+ getPresupuestoDisponible() : double<BR ALIGN="LEFT"/>+ getIngresosPorVentas() / getPerdidasPorVencimiento() : double<BR ALIGN="LEFT"/>- aEntero(texto : String) : int<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    DatosIniciales [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="13">«utility»<BR/><B>DatosIniciales</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12"><U>+ cargar(inv : Inventario) : void</U><BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_interfaz { label="«package» interfaz"; labeljust=l; style="rounded,dashed"; color="#555555"; fontsize=14; margin=14;
    MenuConsola [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="13"><B>MenuConsola</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">- inventario : Inventario<BR ALIGN="LEFT"/>- teclado : Scanner<BR ALIGN="LEFT"/></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12">+ MenuConsola(inventario : Inventario)<BR ALIGN="LEFT"/>+ iniciar() : void<BR ALIGN="LEFT"/>- mostrarMenu() : void<BR ALIGN="LEFT"/>- leer(mensaje : String) : String<BR ALIGN="LEFT"/>- mostrarResultado(error, mensajeExito : String) : void<BR ALIGN="LEFT"/>- imprimirProducto(p : Producto) : void<BR ALIGN="LEFT"/>- registrar() / listar() / buscar()<BR ALIGN="LEFT"/>- vender() / reabastecer()<BR ALIGN="LEFT"/>- alertas() / retirarVencidos() / reporte()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    Main [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF"><TR><TD ALIGN="CENTER" BGCOLOR="#EAF1FB"><FONT POINT-SIZE="13"><B>Main</B></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="12"><U>+ main(args : String[]) : void</U><BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  }
  ProductoPerecedero -> Producto [arrowhead=empty, color="#1F3A5F"];
  ProductoNoPerecedero -> Producto [arrowhead=empty, color="#1F3A5F"];
  Inventario -> Producto [arrowtail=odiamond, arrowhead=none, dir=both, label="productos  0..*", fontsize=10];
  Inventario -> ProductoPerecedero [style=dashed, arrowhead=vee, color="#444444", label="«create»", fontsize=10];
  Inventario -> ProductoNoPerecedero [style=dashed, arrowhead=vee, color="#444444", label="«create»", fontsize=10];
  MenuConsola -> Inventario [arrowhead=vee, headlabel="1", taillabel="1", fontsize=10];
  MenuConsola -> Producto [style=dashed, arrowhead=vee, color="#444444"];
  DatosIniciales -> Inventario [style=dashed, arrowhead=vee, color="#444444"];
  Main -> MenuConsola [style=dashed, arrowhead=vee, color="#444444", label="«create»", fontsize=10];
  Main -> DatosIniciales [style=dashed, arrowhead=vee, color="#444444"];
  Main -> Inventario [style=dashed, arrowhead=vee, color="#444444", label="«create»", fontsize=10];
}
